import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import binom

n = 20
p = 0.1

x = np.arange(21)
prob = binom.pmf(x, n, p)

print("P(X=3):", binom.pmf(3, n, p))

plt.bar(x, prob)
plt.xlabel("Defective Components")
plt.ylabel("Probability")
plt.title("Binomial Distribution")
plt.show()
