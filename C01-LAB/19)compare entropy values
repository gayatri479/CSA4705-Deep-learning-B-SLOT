import numpy as np
import matplotlib.pyplot as plt

P = np.array([0.9, 0.1])
Q = np.array([0.5, 0.5])

H1 = -np.sum(P * np.log2(P))
H2 = -np.sum(Q * np.log2(Q))

print("Entropy P:", H1)
print("Entropy Q:", H2)
print("Greater Uncertainty: Q" if H2 > H1 else "Greater Uncertainty: P")

plt.bar(["P", "Q"], [H1, H2])
plt.ylabel("Entropy (bits)")
plt.show()
